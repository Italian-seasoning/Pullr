{
  "manifest_version": 3,
  "name": "Pullr",
  "description": "Match YouTube music, track listening time, and send media to Pullr.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-bridge.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-capture.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["music-tracker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send to Pullr",
    "default_popup": "popup.html"
  }
}
